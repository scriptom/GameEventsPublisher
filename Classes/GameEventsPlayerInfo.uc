class GameEventsPlayerInfo extends Object;

var int Index;
var int Id;
var byte Team;
var bool Ready;
var String Password;
var String Name;
var int Score;
var int DieCount;
var int KillCount;
var int Spree;

defaultproperties
{
      Index=0
      Id=0
      Team=0
      Ready=False
      Password=""
      Name=""
      Score=0
      DieCount=0
      KillCount=0
      Spree=0
}
